    {
      "type": "text",
      "id": "B_ev_t",
      "x": 1030,
      "y": 484,
      "width": 710,
      "height": 20,
      "text": "SEQUENCE \u2014 Eventual Consistency Write",
      "originalText": "SEQUENCE \u2014 Eventual Consistency Write",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#93c5fd",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 100085,
      "version": 1,
      "versionNonce": 100086,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "B_ev_body",
      "x": 1030,
      "y": 510,
      "width": 710,
      "height": 100,
      "text": "1. Client submits new transaction to Primary log\n2. Primary writes and acks IMMEDIATELY (~5ms)\n3. Change is queued onto a replication stream (e.g. Kafka CDC)\n4. Replicas apply the change asynchronously (100ms-few sec lag)\n5. Dashboard/app may briefly show the old balance",
      "originalText": "1. Client submits new transaction to Primary log\n2. Primary writes and acks IMMEDIATELY (~5ms)\n3. Change is queued onto a replication stream (e.g. Kafka CDC)\n4. Replicas apply the change asynchronously (100ms-few sec lag)\n5. Dashboard/app may briefly show the old balance",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 100087,
      "version": 1,
      "versionNonce": 100088,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.5
    },
