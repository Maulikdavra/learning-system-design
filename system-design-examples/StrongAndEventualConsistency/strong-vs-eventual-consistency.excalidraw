      }
    },
    {
      "type": "text",
      "id": "C_right_title",
      "x": 1040,
      "y": 720,
      "width": 790,
      "height": 28,
      "text": "Transaction History / Statement Feed",
      "originalText": "Transaction History / Statement Feed",
      "fontSize": 19,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#92400e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 100099,
      "version": 1,
      "versionNonce": 100100,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "C_right_body",
      "x": 1040,
      "y": 758,
      "width": 790,
      "height": 220,
      "text": "Needs: EVENTUAL consistency is fine\n\nWhy: seeing yesterday's transaction post 2 seconds late\ncauses no financial harm \u2014 nothing is double-spent\n\nPattern: async CDC stream (Kafka) fans out to read\nreplicas, a search index (Elasticsearch), and the mobile\napp's local cache\n\nTrade-off: fast reads, high availability during a partition,\nbut a brief staleness window on what the user sees",
      "originalText": "Needs: EVENTUAL consistency is fine\n\nWhy: seeing yesterday's transaction post 2 seconds late\ncauses no financial harm \u2014 nothing is double-spent\n\nPattern: async CDC stream (Kafka) fans out to read\nreplicas, a search index (Elasticsearch), and the mobile\napp's local cache\n\nTrade-off: fast reads, high availability during a partition,\nbut a brief staleness window on what the user sees",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 100101,
      "version": 1,
      "versionNonce": 100102,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.5
    },
