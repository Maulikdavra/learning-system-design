      }
    },
    {
      "type": "text",
      "id": "C_left_title",
      "x": 70,
      "y": 720,
      "width": 790,
      "height": 28,
      "text": "Fund Transfer / Balance Debit",
      "originalText": "Fund Transfer / Balance Debit",
      "fontSize": 19,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#1e3a5f",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 100093,
      "version": 1,
      "versionNonce": 100094,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "id": "C_left_body",
      "x": 70,
      "y": 758,
      "width": 790,
      "height": 220,
      "text": "Needs: STRONG consistency\n\nWhy: two ATMs or app sessions must never both read the\nold balance and allow a double withdrawal/overdraft\n\nPattern: synchronous quorum write to the core ledger\n(e.g. mainframe/DB2/Oracle core banking, or a distributed\nSQL store like Spanner/CockroachDB with linearizable writes)\n\nTrade-off: slightly higher write latency; ledger must be\nreachable \u2014 lower availability during a network partition",
      "originalText": "Needs: STRONG consistency\n\nWhy: two ATMs or app sessions must never both read the\nold balance and allow a double withdrawal/overdraft\n\nPattern: synchronous quorum write to the core ledger\n(e.g. mainframe/DB2/Oracle core banking, or a distributed\nSQL store like Spanner/CockroachDB with linearizable writes)\n\nTrade-off: slightly higher write latency; ledger must be\nreachable \u2014 lower availability during a network partition",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#374151",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 100095,
      "version": 1,
      "versionNonce": 100096,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "containerId": null,
      "lineHeight": 1.5
    },
    {
      "type": "rectangle",
      "id": "C_right",
      "x": 1010,
      "y": 700,
      "width": 850,
      "height": 300,
      "strokeColor": "#b45309",
      "backgroundColor": "#fffbeb",
      "fillStyle": "solid",
      "strokeWidth": 2,
