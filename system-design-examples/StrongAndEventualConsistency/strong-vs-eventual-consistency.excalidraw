      "y": 660,
      "width": 1000,
      "height": 30,
      "text": "ENTERPRISE EXAMPLE \u2014 RETAIL BANKING (DEPOSITS)",
      "originalText": "ENTERPRISE EXAMPLE \u2014 RETAIL BANKING (DEPOSITS)",
      "fontSize": 22,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#1e40af",
