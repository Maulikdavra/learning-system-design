      "x": 1040,
      "y": 838,
      "width": 720,
      "height": 26,
      "text": "Then: locate the slow hop with traceroute",
      "originalText": "Then: locate the slow hop with traceroute",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#92400e",
      "backgroundColor": "transparent",
