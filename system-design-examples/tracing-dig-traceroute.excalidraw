    {
      "type": "text",
      "id": "A_ev_body",
      "x": 60,
      "y": 492,
      "width": 720,
      "height": 150,
      "text": ";; ANSWER SECTION:\napi.bank.com.        280   IN   A       203.0.113.42\n\n;; Query time: 24 msec\n;; SERVER: 8.8.8.8#53(8.8.8.8)\n\nRead this for: wrong/stale IP, missing record, high\n\"Query time\" (slow resolver), or bad TTL causing flapping",
      "originalText": ";; ANSWER SECTION:\napi.bank.com.        280   IN   A       203.0.113.42\n\n;; Query time: 24 msec\n;; SERVER: 8.8.8.8#53(8.8.8.8)\n\nRead this for: wrong/stale IP, missing record, high\n\"Query time\" (slow resolver), or bad TTL causing flapping",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
